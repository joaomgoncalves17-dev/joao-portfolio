---
import Base from "../layouts/Base.astro";
---
<Base lang="en">
  <main id="main" class="wrap nf">
    <p class="code tabular" aria-hidden="true">404</p>
    <h1 class="h2">This page doesn’t exist.</h1>
    <p class="lede">The link may be out of date. The portfolio is on the homepage.</p>
    <p class="actions">
      <a href="/" class="btn btn-primary">Go to the homepage</a>
      <a href="/pt/" class="btn btn-frame" lang="pt-PT">Versão portuguesa</a>
    </p>
  </main>
</Base>

<style>
  .nf {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.25rem;
    min-height: 100svh;
    padding-block: 4rem;
  }
  .code { font-size: clamp(5rem, 16vw, 10rem); font-weight: 800; letter-spacing: -0.03em; line-height: 0.9; font-stretch: 125%; color: var(--cobalt); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; }
</style>
