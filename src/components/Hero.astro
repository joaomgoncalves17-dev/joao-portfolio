---
import { Icon } from "astro-icon/components";
import Tile from "./Tile.astro";
import { focusAreas } from "../data/content";
import { useT, pick, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

// Deterministic "hand-laid" rotations and laying order, identical on every build.
const rand = (i: number) => {
  const x = Math.sin(i * 12.9898 + 4.1414) * 43758.5453;
  return x - Math.floor(x);
};
const pattern = Array.from({ length: 28 }, (_, i) => ({
  r: Math.floor(rand(i) * 4),
  d: Math.round(rand(i + 97) * 520),
  o: (0.82 + rand(i + 211) * 0.18).toFixed(2),
}));
---
<section id="home" class="hero" aria-labelledby="hero-title">
  <div class="bleed">
    <div class="panel" data-panel>
      {pattern.map((p) => <Tile r={p.r} class="p" style={`--d:${p.d}ms;--paint-o:${p.o}`} />)}

      <div class="cartouche">
        <h1 id="hero-title" class="headline">
          <span class="line"><span style="--i:0">{t("hero.line1")}</span></span>
          <span class="line accent"><span style="--i:1">{t("hero.line2")}</span></span>
        </h1>
        <div class="foot">
          <div class="intro">
            <p class="sub">{t("hero.sub")}</p>
            <p class="sig" translate="no">João Gonçalves</p>
          </div>
          <div class="ctas">
            <a href="#projects" class="btn btn-primary">
              {t("cta.projects")}
              <Icon name="ph:arrow-right" size={18} aria-hidden="true" class="arrow" />
            </a>
            <a href="#contact" class="btn btn-frame">{t("cta.contact")}</a>
          </div>
        </div>
      </div>

      <h2 class="sr-only">{t("hero.focus")}</h2>
      <ul class="focus">
        {focusAreas.map((f, i) => (
          <li class="fig" style={`--d:${560 + i * 90}ms`}>
            <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="#tile-fig" /></svg>
            <span class="fig-body">
              <Icon name={f.icon} size={28} aria-hidden="true" />
              <span class="fig-label" title={pick(f.name, lang)}>{pick(f.short, lang)}</span>
              <span class="sr-only">: {pick(f.name, lang)}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // A touched pattern tile turns a quarter, rerouting the network through its neighbours.
  const panel = document.querySelector<HTMLElement>("[data-panel]");
  panel?.addEventListener(
    "pointerover",
    (e) => {
      const tile = (e.target as Element).closest<HTMLElement>(".t.p");
      if (!tile) return;
      const r = Number(tile.style.getPropertyValue("--r")) || 0;
      tile.style.setProperty("--r", String(r + 1));
    },
    { passive: true },
  );
</script>

<style>
  /* The panel is full-bleed: twelve square tiles across, six rows down to the fold. */
  .bleed { display: flex; justify-content: center; }
  .panel {
    --cols: 12;
    --tile: min(calc((100vw - 26px) / 12), calc((100svh - var(--nav-h) - 14px) / 6));
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--tile));
    grid-auto-flow: row dense;
    gap: 2px;
    padding: 2px;
    background: var(--grout);
  }

  .cartouche {
    grid-column: 2 / span 10;
    grid-row: 2 / span 4;
    container-type: inline-size;
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 5cqi, 3.75rem);
    padding: clamp(1.4rem, 3.6cqi, 2.75rem) clamp(1.4rem, 4.4cqi, 3.25rem);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 2px var(--cobalt),
      inset 0 0 0 7px var(--surface),
      inset 0 0 0 8px color-mix(in srgb, var(--cobalt) 45%, transparent);
  }
  /* Azulejo panels are signed at the foot; so is this one. */
  .intro { display: grid; gap: 0.9rem; }
  .sig {
    font-size: clamp(0.95rem, 1.8cqi, 1.1rem);
    font-weight: 760;
    font-stretch: 125%;
    color: var(--cobalt);
  }
  .headline {
    font-size: clamp(1.75rem, 6cqi, 4.5rem);
    font-weight: 820;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .line { display: block; overflow: clip; padding-bottom: 0.08em; }
  .line > span { display: block; }
  .accent { color: var(--cobalt); }

  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.25rem 2.5rem;
  }
  .sub {
    max-width: 34rem;
    font-size: clamp(1.02rem, 2cqi, 1.22rem);
    line-height: 1.5;
    color: var(--slate);
  }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* Focus areas as figure tiles: one motif per tile, on the same network nodes. */
  .focus { display: contents; }
  .fig {
    grid-row: 6;
    position: relative;
    aspect-ratio: 1;
  }
  .fig:nth-child(1) { grid-column: 2; }
  .fig:nth-child(2) { grid-column: 3; }
  .fig:nth-child(3) { grid-column: 4; }
  .fig:nth-child(4) { grid-column: 5; }
  .fig > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fig-body {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.3rem;
    color: var(--tile-paint);
  }
  .fig-label {
    font-size: clamp(0.7rem, 0.95vw, 0.84rem);
    font-weight: 750;
    font-stretch: 108%;
    color: var(--ink);
  }

  /* Laying the panel: tiles settle into the grout in a scattered order, then the words. */
  @media (prefers-reduced-motion: no-preference) {
    .panel :global(.p svg), .fig > svg, .fig-body {
      animation: lay 900ms var(--ease) both;
      animation-delay: var(--d);
    }
    .cartouche { animation: seat 900ms var(--ease) 120ms both; }
    .line > span {
      animation: rise 1000ms var(--ease) both;
      animation-delay: calc(380ms + var(--i) * 120ms);
    }
    .foot { animation: fade 800ms var(--ease) 700ms both; }
    @keyframes lay { from { opacity: 0; transform: scale(0.82) rotate(-90deg); } }
    @keyframes seat { from { opacity: 0; transform: scale(0.985); } }
    @keyframes rise { from { transform: translateY(104%); } }
    @keyframes fade { from { opacity: 0; transform: translateY(10px); } }
  }

  /* Tablet: the cartouche takes the full row between two bands of tiles. */
  @media (max-width: 63.99rem) {
    .panel { --cols: 8; --tile: calc((100vw - 18px) / 8); }
    .cartouche { grid-column: 1 / -1; grid-row: 2; }
    .fig { grid-row: 3; }
    .fig:nth-child(1) { grid-column: 1; }
    .fig:nth-child(2) { grid-column: 2; }
    .fig:nth-child(3) { grid-column: 3; }
    .fig:nth-child(4) { grid-column: 4; }
    .panel :global(.p:nth-child(n + 13)) { display: none; }
    .fig-label { font-size: 0.82rem; }
  }
  @media (max-width: 47.99rem) {
    .foot { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 39.99rem) {
    .panel { --cols: 4; --tile: calc((100vw - 10px) / 4); }
    .panel :global(.p:nth-child(n + 9)) { display: none; }
    .headline { font-size: clamp(1.6rem, 8.6cqi, 2.4rem); }
    .line > span { white-space: normal; }
    .ctas .btn { flex: 1 1 100%; }
  }
</style>
