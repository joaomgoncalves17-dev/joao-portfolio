---
/**
 * Projects as case files: the story leads; material that exists is linked, and
 * material still to come is named once, honestly, instead of as a row of placeholders.
 */
import { Icon } from "astro-icon/components";
import { projects, isTodo, type AssetKind } from "../data/content";
import { useT, pick, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const assetIcon: Record<AssetKind, string> = {
  repo: "lucide:github",
  docs: "lucide:file-text",
  diagram: "lucide:workflow",
  screenshots: "lucide:image",
};
const statusClass = { "in-progress": "badge-gold", "under-construction": "badge-gold", completed: "badge-purple" } as const;

const cases = projects.map((p) => {
  const ready = p.assets.filter((a) => !isTodo(a.href)) as { kind: AssetKind; href: string }[];
  const pending = p.assets.filter((a) => isTodo(a.href)).map((a) => t(`projects.asset.${a.kind}`));
  return { p, ready, pending };
});
const list = (items: string[]) =>
  new Intl.ListFormat(lang === "pt" ? "pt-PT" : "en-GB", { type: "conjunction" }).format(
    items.map((s, i) => (i === 0 ? s : s.charAt(0).toLowerCase() + s.slice(1))),
  );
---
<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="head">
      <h2 id="projects-title" class="h2">{t("projects.title")}</h2>
      <p class="lede">{t("projects.intro")}</p>
    </div>

    <div class="list">
      {cases.map(({ p, ready, pending }) => (
        <article class="project reveal" aria-labelledby={`p-${p.id}`}>
          <div class="info">
            <span class:list={["badge", statusClass[p.status]]}>{t(`projects.status.${p.status}`)}</span>
            <h3 id={`p-${p.id}`} class="title">{pick(p.title, lang)}</h3>
            <p class="summary">{pick(p.summary, lang)}</p>
            <ul class="topics" aria-label={t("projects.topics")}>
              {p.topics.map((topic) => <li translate={typeof topic === "string" ? "no" : undefined}>{pick(topic, lang)}</li>)}
            </ul>
          </div>

          <aside class="side" aria-label={t("projects.material")}>
            {p.image ? (
              <img src={p.image.src} alt={pick(p.image.alt, lang)} width="1600" height="1000" loading="lazy" decoding="async" class="shot" />
            ) : (
              <div class="blueprint" aria-hidden="true">
                <span class="bp-icon"><Icon name={p.icon} size={30} /></span>
              </div>
            )}

            {ready.length > 0 && (
              <ul class="ready">
                {ready.map((a) => (
                  <li>
                    <a href={a.href} target="_blank" rel="noopener noreferrer" class="asset">
                      <Icon name={assetIcon[a.kind]} size={18} aria-hidden="true" />
                      <span>{t(`projects.asset.${a.kind}`)}</span>
                      <Icon name="lucide:arrow-up-right" size={18} aria-hidden="true" class="go" />
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {pending.length > 0 && (
              <p class="pending">
                <Icon name="lucide:clock-3" size={16} aria-hidden="true" />
                <span>{t("projects.pending")} {list(pending)}.</span>
              </p>
            )}
          </aside>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: grid; gap: 1rem; max-width: 40rem; }
  .list { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(1.5rem, 3vw, 2rem); margin-top: clamp(2.5rem, 5vw, 4rem); }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    background: var(--white);
    border: 1px solid var(--rule);
    border-radius: 12px;
    transition: border-color 260ms var(--ease), transform 260ms var(--ease), box-shadow 260ms var(--ease);
  }
  .project:hover {
    border-color: color-mix(in srgb, var(--purple) 45%, var(--rule));
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -22px rgb(95 63 138 / 0.35);
  }

  .info { display: grid; align-content: start; justify-items: start; gap: 1rem; }
  .title {
    font-size: clamp(1.6rem, 2.8vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .summary { color: var(--gray); font-size: 1.075rem; max-width: 56ch; }
  .topics { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.25rem; }
  .topics li {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    font-size: 0.85rem;
    font-weight: 550;
  }

  .side { display: grid; align-content: start; gap: 1rem; }
  .shot { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius); }

  /* Placeholder: a small drafting-grid slot where the architecture diagram will go. */
  .blueprint {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    background-color: var(--purple-tint);
    background-image:
      linear-gradient(color-mix(in srgb, var(--purple) 10%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--purple) 10%, transparent) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: -1px -1px;
  }
  .bp-icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    background: var(--white);
    color: var(--purple);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--purple) 25%, transparent);
    transition: transform 400ms var(--ease);
  }
  .project:hover .bp-icon { transform: scale(1.06) rotate(-4deg); }

  .ready li { border-bottom: 1px solid var(--rule); }
  .asset {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 600;
    text-decoration: none;
  }
  .asset :global(svg) { color: var(--purple); }
  .asset .go { transition: transform 240ms var(--ease); }
  .asset:hover span { color: var(--purple-deep); text-decoration: underline; }
  .asset:hover .go { transform: translate(2px, -2px); }

  .pending {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--gray);
  }
  .pending :global(svg) { flex: none; color: var(--purple); transform: translateY(2px); }

  @media (max-width: 55.99rem) {
    .project { grid-template-columns: minmax(0, 1fr); }
    .blueprint { display: none; }
  }
  @media (hover: none) {
    .project:hover { transform: none; box-shadow: none; }
  }
</style>
