---
/**
 * Projects as case files: the story leads; material that exists is linked, and
 * material still to come is named once, honestly, instead of as a row of placeholders.
 */
import { Icon } from "astro-icon/components";
import Tile from "./Tile.astro";
import { projects, isTodo, type AssetKind } from "../data/content";
import { useT, pick, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const assetIcon: Record<AssetKind, string> = {
  repo: "ph:github-logo",
  docs: "ph:file-text",
  diagram: "ph:tree-structure",
  screenshots: "ph:image",
};
const statusClass = { "in-progress": "stamp-ochre", "under-construction": "stamp-ochre", completed: "stamp-cobalt" } as const;
// A 3x3 field per project; the centre is the project's figure tile.
const field = (seed: number) =>
  Array.from({ length: 8 }, (_, i) => Math.floor(Math.abs(Math.sin((i + 1) * 7.31 + seed * 3.7)) * 4));

const cases = projects.map((p, n) => {
  const ready = p.assets.filter((a) => !isTodo(a.href)) as { kind: AssetKind; href: string }[];
  const pending = p.assets.filter((a) => isTodo(a.href)).map((a) => t(`projects.asset.${a.kind}`));
  return { p, ready, pending, rots: field(n + 1) };
});
const list = (items: string[]) =>
  new Intl.ListFormat(lang === "pt" ? "pt-PT" : "en-GB", { type: "conjunction" }).format(
    items.map((s, i) => (i === 0 ? s : s.charAt(0).toLowerCase() + s.slice(1))),
  );
---
<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="head">
      <h2 id="projects-title" class="h2">{t("projects.title")}</h2>
      <p class="lede">{t("projects.intro")}</p>
    </div>

    <div class="list">
      {cases.map(({ p, ready, pending, rots }) => (
        <article class="project" aria-labelledby={`p-${p.id}`}>
          <div class="field" aria-hidden={p.image ? undefined : "true"}>
            {p.image ? (
              <img src={p.image.src} alt={pick(p.image.alt, lang)} width="1600" height="1000" loading="lazy" decoding="async" class="shot" />
            ) : (
              <>
                {rots.slice(0, 4).map((r, i) => <Tile r={r} class="ft" style={`--paint-o:${0.84 + ((i * 5 + r) % 5) * 0.04}`} />)}
                <span class="fcenter">
                  <svg viewBox="0 0 100 100" focusable="false"><use href="#tile-fig" /></svg>
                  <Icon name={p.icon} size={40} />
                </span>
                {rots.slice(4).map((r, i) => <Tile r={r} class="ft" style={`--paint-o:${0.84 + ((i * 3 + r) % 5) * 0.04}`} />)}
              </>
            )}
          </div>

          <div class="info">
            <span class:list={["stamp", statusClass[p.status]]}>{t(`projects.status.${p.status}`)}</span>
            <h3 id={`p-${p.id}`} class="title">{pick(p.title, lang)}</h3>
            <p class="summary">{pick(p.summary, lang)}</p>
            <ul class="topics" aria-label={t("projects.topics")}>
              {p.topics.map((topic) => <li translate={typeof topic === "string" ? "no" : undefined}>{pick(topic, lang)}</li>)}
            </ul>

            {ready.length > 0 && (
              <ul class="ready" aria-label={t("projects.material")}>
                {ready.map((a) => (
                  <li>
                    <a href={a.href} target="_blank" rel="noopener noreferrer" class="asset">
                      <Icon name={assetIcon[a.kind]} size={18} aria-hidden="true" />
                      <span>{t(`projects.asset.${a.kind}`)}</span>
                      <Icon name="ph:arrow-up-right" size={18} aria-hidden="true" class="go" />
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {pending.length > 0 && (
              <p class="pending">
                <Icon name="ph:clock" size={18} aria-hidden="true" />
                <span>{t("projects.pending")} {list(pending)}.</span>
              </p>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .head { display: grid; gap: 1rem; max-width: 42rem; }
  .list { display: grid; gap: clamp(1.75rem, 3.5vw, 2.5rem); margin-top: clamp(2.5rem, 5vw, 4rem); }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(1.75rem, 4.5vw, 4rem);
    padding: clamp(1rem, 2.4vw, 1.75rem);
    background: var(--surface);
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--rule);
    transition: box-shadow 300ms var(--ease);
  }
  .project:hover { box-shadow: inset 0 0 0 1.5px var(--cobalt), 0 24px 40px -30px color-mix(in srgb, var(--cobalt) 70%, transparent); }
  .project:nth-child(even) { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .project:nth-child(even) .field { order: 2; }

  /* The tile field: a 3x3 patch of the network with the project's figure at its centre.
     Hovering the case file turns every tile a quarter, rerouting the whole patch. */
  .field {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    padding: 2px;
    background: var(--grout);
    border-radius: 3px;
  }
  .project:hover .field :global(.ft) { transform: rotate(calc((var(--r) + 1) * 90deg)); }
  .fcenter { position: relative; display: grid; place-items: center; aspect-ratio: 1; color: var(--tile-paint); }
  .fcenter > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .shot { grid-column: 1 / -1; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .field :global(.ft svg) {
        animation: route linear both;
        animation-timeline: view();
        animation-range: entry 5% cover 40%;
      }
      @keyframes route { from { transform: rotate(-180deg) scale(0.9); opacity: 0.25; } }
    }
  }

  .info { display: grid; align-content: start; justify-items: start; gap: 1rem; padding-block: 0.5rem; }
  .title {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .summary { color: var(--slate); font-size: 1.075rem; max-width: 58ch; }
  .topics { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.25rem; }
  .topics li {
    padding: 0.22rem 0.65rem;
    border-radius: 3px;
    background: var(--ground);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    font-size: 0.85rem;
    font-weight: 580;
  }

  .ready { width: 100%; }
  .ready li { border-bottom: 1px solid var(--rule); }
  .asset {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-weight: 650;
    text-decoration: none;
  }
  .asset :global(svg) { color: var(--cobalt); }
  .asset .go { transition: transform 240ms var(--ease); }
  .asset:hover span { color: var(--cobalt); text-decoration: underline; }
  .asset:hover .go { transform: translate(2px, -2px); }

  .pending {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin-top: 0.25rem;
    font-size: 0.94rem;
    line-height: 1.45;
    color: var(--slate);
  }
  .pending :global(svg) { flex: none; color: var(--cobalt); transform: translateY(3px); }

  @media (max-width: 55.99rem) {
    .project, .project:nth-child(even) { grid-template-columns: minmax(0, 1fr); }
    .project:nth-child(even) .field { order: 0; }
    .field { max-width: 22rem; }
  }
  @media (hover: none) {
    .project:hover .field :global(.ft) { transform: rotate(calc(var(--r) * 90deg)); }
  }
</style>
