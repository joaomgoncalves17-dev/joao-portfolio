---
import { Icon } from "astro-icon/components";
import Frieze from "./Frieze.astro";
import { skillGroups } from "../data/content";
import { useT, pick, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const anyLearning = skillGroups.some((g) => g.items.some((s) => s.level === "learning"));
---
<section id="skills" class="skills" aria-labelledby="skills-title">
  <Frieze />
  <div class="wrap section inner">
    <div class="head">
      <h2 id="skills-title" class="h2">{t("skills.title")}</h2>
      <p class="lede">{t("skills.intro")}</p>
      {anyLearning && (
        <p class="legend">
          <span class="stamp stamp-ochre">{t("skills.learning")}</span>
          <span>{t("skills.legend")}</span>
        </p>
      )}
    </div>

    <div class="groups">
      {skillGroups.map((g, i) => (
        <section class="group reveal" aria-labelledby={`sg-${i}`}>
          <span class="gtile" aria-hidden="true">
            <svg viewBox="0 0 100 100" focusable="false"><use href="#tile-fig" /></svg>
            <Icon name={g.icon} size={26} />
          </span>
          <h3 id={`sg-${i}`} class="gname">{pick(g.name, lang)}</h3>
          <ul>
            {g.items.map((s) => (
              <li>
                <span translate={typeof s.name === "string" ? "no" : undefined}>{pick(s.name, lang)}</span>
                {s.level === "learning" && <span class="stamp stamp-ochre">{t("skills.learning")}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
  <Frieze />
</section>

<style>
  .skills { background: var(--surface); }
  .inner { display: grid; gap: clamp(2.75rem, 5vw, 4rem); }
  .head { display: grid; gap: 1rem; max-width: 44rem; }
  .legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; font-size: 0.95rem; color: var(--slate); }

  .groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3rem) var(--gutter);
  }
  .group { display: grid; align-content: start; }
  .gtile {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.25rem;
    aspect-ratio: 1;
    color: var(--tile-paint);
    border-radius: 2px;
    box-shadow: 0 0 0 2px var(--grout);
  }
  .gtile svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .gtile :global(svg:last-child) { position: relative; }
  .gname {
    margin-top: 1.1rem;
    padding-bottom: 0.8rem;
    border-bottom: 2px solid var(--cobalt);
    font-size: 1.15rem;
    font-weight: 780;
    font-stretch: 110%;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.85rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--rule);
    font-size: 1.02rem;
  }
  li:last-child { border-bottom: 0; }

  @media (max-width: 63.99rem) {
    .groups { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 39.99rem) {
    .groups { grid-template-columns: minmax(0, 1fr); }
  }
</style>
