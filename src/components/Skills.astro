---
import { Icon } from "astro-icon/components";
import { skillGroups } from "../data/content";
import { useT, pick, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section id="skills" class="section skills" aria-labelledby="skills-title">
  <div class="wrap grid">
    <div class="head">
      <h2 id="skills-title" class="h2">{t("skills.title")}</h2>
      <p class="lede">{t("skills.intro")}</p>
      <p class="legend">
        <span class="badge badge-quiet">{t("skills.learning")}</span>
        <span>{t("skills.legend")}</span>
      </p>
    </div>

    <div class="groups">
      {skillGroups.map((g, i) => (
        <section class="group" aria-labelledby={`sg-${i}`}>
          <h3 id={`sg-${i}`} class="gname">
            <Icon name={g.icon} size={20} aria-hidden="true" />
            {pick(g.name, lang)}
          </h3>
          <ul>
            {g.items.map((s) => (
              <li>
                <span translate={typeof s.name === "string" ? "no" : undefined}>{pick(s.name, lang)}</span>
                {s.level === "learning" && <span class="badge badge-quiet">{t("skills.learning")}</span>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .skills { background: var(--white); border-block: 1px solid var(--rule); }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2rem);
    row-gap: 3rem;
  }
  .head {
    grid-column: 1 / span 4;
    align-self: start;
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
    display: grid;
    gap: 1.25rem;
  }
  .legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.92rem; color: var(--gray); }

  .groups {
    grid-column: 6 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 3rem);
  }
  .gname {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.85rem;
    border-bottom: 2px solid var(--ink);
    font-size: 1.2rem;
    font-weight: 750;
    letter-spacing: -0.015em;
  }
  .gname :global(svg) { color: var(--purple); }
  ul { margin-top: 0.35rem; }
  li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.9rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--rule);
    font-size: 1.05rem;
  }
  li:last-child { border-bottom: 0; }

  @media (max-width: 63.99rem) {
    .head { grid-column: 1 / -1; position: static; max-width: 36rem; }
    .groups { grid-column: 1 / -1; }
  }
  @media (max-width: 39.99rem) {
    .groups { grid-template-columns: 1fr; }
  }
</style>
