---
import Text from "./Text.astro";
import { skillGroups } from "../data/content";
import { useT, pick, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section id="skills" class="skills" aria-labelledby="skills-title">
  <div class="inner">
    <h2 id="skills-title" class="h2 wide">{t("skills.title")}</h2>
    <div class="groups">
      {skillGroups.map((g) => (
        <section class="group" aria-label={pick(g.name, lang)}>
          <h3 class="gname semi-wide">{pick(g.name, lang)}</h3>
          <dl>
            {g.skills.map((s) => (
              <div class="row">
                <dt><Text value={s.name} lang={lang} /></dt>
                <dd>{t("skills.proof")} <Text value={s.proof} lang={lang} /></dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .skills { background: var(--l7); border-block: 1px solid var(--rule); }
  .inner {
    max-width: 90rem;
    margin-inline: auto;
    padding: clamp(4rem, 8vw, 6.5rem) clamp(1rem, 3vw, 2.5rem);
  }
  .h2 { font-size: clamp(1.75rem, 3.2vw, 2.75rem); font-weight: 750; letter-spacing: -0.02em; }
  .groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .gname {
    font-size: 1.2rem;
    font-weight: 700;
    padding-bottom: 0.65rem;
    border-bottom: 2px solid var(--ink);
  }
  dl { display: grid; gap: 1.1rem; margin-top: 1.1rem; }
  dt { font-weight: 650; font-size: 1.05rem; }
  dd { color: var(--ink-soft); font-size: 0.92rem; margin-top: 0.15rem; }
</style>
