---
import { Icon } from "astro-icon/components";
import { useT, homeHref, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === "en" ? "pt" : "en";
---
<footer class="footer">
  <div class="wrap foot">
    <p>© {new Date().getFullYear()} {t("footer.rights")}</p>
    <div class="foot-links">
      <a href={homeHref(other)} hreflang={other} aria-label={t("nav.switchLabel")}>{t("nav.switch")}</a>
      <a href="#home">
        {t("footer.top")}
        <Icon name="ph:arrow-up" size={16} aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--ground); }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
    font-size: 0.92rem;
    color: var(--slate);
  }
  .foot-links { display: flex; gap: 1.5rem; }
  .foot-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .foot-links a:hover { color: var(--cobalt); text-decoration: underline; }

</style>
