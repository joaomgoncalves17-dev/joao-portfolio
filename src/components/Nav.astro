---
import { Icon } from "astro-icon/components";
import { useT, homeHref, type Lang, type UIKey } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const other: Lang = lang === "en" ? "pt" : "en";

const links: { id: string; key: UIKey }[] = [
  { id: "home", key: "nav.home" },
  { id: "about", key: "nav.about" },
  { id: "skills", key: "nav.skills" },
  { id: "projects", key: "nav.projects" },
  { id: "education", key: "nav.education" },
];
---
<header class="nav">
  <div class="wrap bar">
    <a href="#home" class="brand" aria-label="João Gonçalves, home">
      <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
        <rect width="40" height="40" rx="9" fill="var(--purple)" />
        <rect x="28" y="28" width="12" height="12" rx="3" fill="var(--gold)" />
        <text x="18" y="25.5" text-anchor="middle" font-size="15" font-weight="800" fill="#fff" font-family="inherit" letter-spacing="-0.5">JG</text>
      </svg>
      <span class="brand-name" translate="no">João Gonçalves</span>
    </a>

    <nav aria-label={t("nav.label")} class="desktop">
      <ul>
        {links.map((l) => (
          <li><a href={`#${l.id}`} class="link" data-section={l.id}>{t(l.key)}</a></li>
        ))}
        <li>
          <a href={homeHref(other)} hreflang={other} lang={other === "pt" ? "pt-PT" : "en"} aria-label={t("nav.switchLabel")} class="lang">
            {t("nav.switch")}
          </a>
        </li>
        <li><a href="#contact" class="btn btn-primary contact" data-section="contact">{t("nav.contact")}</a></li>
      </ul>
    </nav>

    <button type="button" class="menu-btn" popovertarget="menu" aria-controls="menu">
      <Icon name="lucide:menu" size={22} aria-hidden="true" class="i-open" />
      <Icon name="lucide:x" size={22} aria-hidden="true" class="i-close" />
      <span>{t("nav.menu")}</span>
    </button>
  </div>

  <div id="menu" popover class="menu">
    <nav aria-label={t("nav.label")}>
      <ul>
        {links.map((l) => (
          <li><a href={`#${l.id}`} class="m-link">{t(l.key)}</a></li>
        ))}
        <li><a href="#contact" class="m-link">{t("nav.contact")}</a></li>
      </ul>
      <a href={homeHref(other)} hreflang={other} lang={other === "pt" ? "pt-PT" : "en"} class="m-lang">
        <Icon name="lucide:languages" size={18} aria-hidden="true" />
        {t("nav.switchLabel")}
      </a>
    </nav>
  </div>
</header>

<script>
  // Close the mobile menu after a link is chosen.
  const menu = document.getElementById("menu");
  menu?.querySelectorAll("a[href^='#']").forEach((a) =>
    a.addEventListener("click", () => menu.hidePopover()),
  );

  // Mark the nav link of the section currently in view.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".desktop [data-section]");
  const sections = [...navLinks]
    .map((a) => document.getElementById(a.dataset.section!))
    .filter((s): s is HTMLElement => s !== null);
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navLinks.forEach((a) =>
          a.dataset.section === entry.target.id
            ? a.setAttribute("aria-current", "true")
            : a.removeAttribute("aria-current"),
        );
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  sections.forEach((s) => observer.observe(s));
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--nav-h);
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-decoration: none;
  }
  .mark { width: 2.25rem; height: 2.25rem; flex: none; transition: transform 300ms var(--ease); }
  .brand:hover .mark { transform: rotate(-6deg); }
  .brand-name { font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em; white-space: nowrap; }

  .desktop ul { display: flex; align-items: center; gap: clamp(1rem, 2vw, 1.75rem); }
  .link {
    position: relative;
    display: inline-block;
    padding-block: 0.6rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--gray);
    text-decoration: none;
    transition: color 200ms var(--ease);
  }
  .link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.3rem;
    height: 2px;
    background: var(--purple);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 280ms var(--ease);
  }
  .link:hover, .link[aria-current="true"] { color: var(--ink); }
  .link:hover::after, .link[aria-current="true"]::after { transform: scaleX(1); }
  .lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    transition: box-shadow 200ms var(--ease), color 200ms var(--ease);
  }
  .lang:hover { box-shadow: inset 0 0 0 1.5px var(--purple); color: var(--purple-deep); }
  .contact { min-height: 2.75rem; padding-block: 0.5rem; }

  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.9rem;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    font: inherit;
    font-weight: 650;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
  }
  .i-close { display: none; }
  .nav:has(#menu:popover-open) .i-open { display: none; }
  .nav:has(#menu:popover-open) .i-close { display: inline; }

  .menu {
    position: fixed;
    inset: var(--nav-h) 0 auto 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0.5rem clamp(1.25rem, 5vw, 3rem) 2rem;
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 24px 40px -24px rgb(36 33 43 / 0.25);
    overscroll-behavior: contain;
    max-height: calc(100dvh - var(--nav-h));
    overflow-y: auto;
  }
  .menu::backdrop { background: rgb(36 33 43 / 0.2); }
  .m-link {
    display: block;
    padding-block: 0.9rem;
    font-size: 1.6rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .m-link:hover { color: var(--purple); }
  .m-lang {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 1.25rem;
    font-weight: 600;
    color: var(--purple-deep);
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu:popover-open { animation: drop 320ms var(--ease); }
    @keyframes drop { from { opacity: 0; transform: translateY(-8px); } }
  }

  @media (max-width: 63.99rem) {
    .desktop { display: none; }
    .menu-btn { display: inline-flex; }
  }
  @media (min-width: 64rem) {
    .menu { display: none; }
  }
</style>
