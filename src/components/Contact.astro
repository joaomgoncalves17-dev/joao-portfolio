---
import { Icon } from "astro-icon/components";
import MaybeLink from "./MaybeLink.astro";
import { contact, isTodo, type Todo } from "../data/content";
import { useT, pick, type Lang, type UIKey } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const rows: { key: UIKey; icon: string; value: string | Todo; href: (v: string) => string; external: boolean }[] = [
  { key: "contact.email", icon: "lucide:mail", value: contact.email, href: (v) => `mailto:${v}`, external: false },
  { key: "contact.github", icon: "lucide:github", value: contact.github, href: (v) => v, external: true },
  { key: "contact.linkedin", icon: "lucide:linkedin", value: contact.linkedin, href: (v) => v, external: true },
];
const display = (v: string) => v.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---
<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="wrap grid">
    <div class="head">
      <h2 id="contact-title" class="title">{t("contact.title")}</h2>
      <p class="sub">{t("contact.sub")}</p>
      <MaybeLink href={contact.cv} class="btn btn-gold cv" download>
        <Icon name="lucide:download" size={18} aria-hidden="true" />
        {t("contact.cvButton")}
      </MaybeLink>
      {isTodo(contact.cv) && <p class="note">{pick(contact.cv.todo, lang)}</p>}
    </div>

    <ul class="rows">
      {rows.map((r) => (
        <li>
          <MaybeLink href={isTodo(r.value) ? r.value : r.href(r.value)} class="row" external={r.external}>
            <Icon name={r.icon} size={22} aria-hidden="true" class="r-icon" />
            <span class="r-label">{t(r.key)}</span>
            <span class="r-value">{isTodo(r.value) ? pick(r.value.todo, lang) : display(r.value)}</span>
            {!isTodo(r.value) && <Icon name="lucide:arrow-up-right" size={20} aria-hidden="true" class="r-go" />}
          </MaybeLink>
        </li>
      ))}
    </ul>
  </div>
</section>


<style>
  .contact {
    background: var(--purple);
    color: var(--white);
    padding-block: clamp(5rem, 11vw, 8.5rem);
  }
  .contact ::selection { background: var(--gold); color: var(--ink); }
  .contact :focus-visible { outline-color: var(--gold); }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2rem);
    row-gap: 3rem;
    align-items: start;
  }
  .head { grid-column: 1 / span 6; display: grid; justify-items: start; gap: 1.5rem; }
  .title {
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .sub { font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.5; max-width: 32rem; }
  .cv { margin-top: 0.5rem; }
  .cv[aria-disabled="true"] {
    background: transparent;
    color: var(--white);
    box-shadow: none;
    border: 1.5px dashed rgb(255 255 255 / 0.7);
  }
  .note { font-size: 0.9rem; font-style: italic; margin-top: -0.75rem; }

  .rows { grid-column: 8 / -1; border-top: 1px solid rgb(255 255 255 / 0.45); }
  .rows li { border-bottom: 1px solid rgb(255 255 255 / 0.45); }
  .rows :global(.row) {
    display: grid;
    grid-template-columns: auto 6rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.25rem;
    padding-block: 0.75rem;
    text-decoration: none;
  }
  .rows :global(.r-icon), .rows :global(.r-go) { transition: transform 260ms var(--ease); }
  .rows :global(a.row:hover .r-icon) { transform: translateX(4px); }
  .rows :global(a.row:hover .r-go) { transform: translate(3px, -3px); }
  .rows :global(a.row:hover .r-value) { text-decoration: underline; }
  .r-label { font-weight: 700; font-size: 1.1rem; }
  .r-value { font-size: 1rem; overflow-wrap: anywhere; }
  .rows :global(span.row .r-value) { font-style: italic; }

  @media (max-width: 63.99rem) {
    .head, .rows { grid-column: 1 / -1; }
  }
  @media (max-width: 39.99rem) {
    .rows :global(.row) { grid-template-columns: auto minmax(0, 1fr); row-gap: 0.15rem; }
    .r-value { grid-column: 2; }
  }
</style>
