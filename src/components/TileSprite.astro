---
/**
 * The network tile. Two painted arcs join adjacent edge midpoints; a half-node sits
 * on every edge, so a node only becomes whole where two tiles meet. Rotating a tile
 * by 90 degrees reroutes the arcs while every node keeps its connection.
 * Colours come from --tile-bg / --tile-paint / --tile-wash on the referencing element.
 */
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <!-- Hand-painted line: a slight wobble so the cobalt reads as brushed onto glaze. -->
    <filter id="paint" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" seed="7" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="1.6" xChannelSelector="R" yChannelSelector="G" />
    </filter>
    <symbol id="tile-net" viewBox="0 0 100 100">
      <rect width="100" height="100" fill="var(--tile-bg)" />
      <path d="M0 0H22L0 22Z M100 0V22L78 0Z M100 100H78L100 78Z M0 100V78L22 100Z" fill="var(--tile-wash)" />
      <path d="M50 50l9-9 9 9-9 9z M50 50l-9 9-9-9 9-9z" fill="var(--tile-wash)" />
      <g filter="url(#paint)" style="opacity: var(--paint-o, 1)">
      <g fill="none" stroke-linecap="butt">
        <path d="M50 0A50 50 0 0 1 0 50 M100 50A50 50 0 0 0 50 100" stroke="var(--tile-paint)" stroke-width="10" />
        <path d="M50 0A50 50 0 0 1 0 50 M100 50A50 50 0 0 0 50 100" stroke="var(--tile-bg)" stroke-width="2.2" />
      </g>
      <g fill="var(--tile-paint)">
        <circle cx="50" cy="0" r="11" />
        <circle cx="0" cy="50" r="11" />
        <circle cx="50" cy="100" r="11" />
        <circle cx="100" cy="50" r="11" />
      </g>
      <g fill="var(--tile-bg)">
        <circle cx="50" cy="0" r="4.5" />
        <circle cx="0" cy="50" r="4.5" />
        <circle cx="50" cy="100" r="4.5" />
        <circle cx="100" cy="50" r="4.5" />
      </g>
      </g>
    </symbol>
    <symbol id="tile-fig" viewBox="0 0 100 100">
      <rect width="100" height="100" fill="var(--tile-bg)" />
      <path d="M0 0H22L0 22Z M100 0V22L78 0Z M100 100H78L100 78Z M0 100V78L22 100Z" fill="var(--tile-wash)" />
      <circle cx="50" cy="50" r="33" fill="none" stroke="var(--tile-wash)" stroke-width="2" />
      <g fill="var(--tile-paint)">
        <circle cx="50" cy="0" r="11" />
        <circle cx="0" cy="50" r="11" />
        <circle cx="50" cy="100" r="11" />
        <circle cx="100" cy="50" r="11" />
      </g>
      <g fill="var(--tile-bg)">
        <circle cx="50" cy="0" r="4.5" />
        <circle cx="0" cy="50" r="4.5" />
        <circle cx="50" cy="100" r="4.5" />
        <circle cx="100" cy="50" r="4.5" />
      </g>
    </symbol>
  </defs>
</svg>
