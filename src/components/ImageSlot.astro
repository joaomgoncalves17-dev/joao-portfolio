---
/** A real image, or a labelled slot describing the image still needed. */
import { Icon } from "astro-icon/components";
import { isTodo, type Todo } from "../data/content";
import { pick, type Lang, type L } from "../i18n/ui";

interface Props {
  image: { src: string; alt: L } | Todo;
  lang: Lang;
  ratio: string;
  class?: string;
  eager?: boolean;
}
const { image, lang, ratio, class: cls, eager } = Astro.props;
---
{isTodo(image) ? (
  <div class:list={["slot", cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Image placeholder: ${image.todo}`}>
    <Icon name="ph:image-square" size={28} aria-hidden="true" />
    <span class="ph">[{image.todo}]</span>
  </div>
) : (
  <img
    src={image.src}
    alt={pick(image.alt, lang)}
    class:list={["block w-full object-cover", cls]}
    style={`aspect-ratio:${ratio}`}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
)}

<style>
  .slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    color: var(--ph);
    background: var(--ph-bg);
    border: 1px dashed var(--ph);
    border-radius: var(--radius-ui);
  }
</style>
