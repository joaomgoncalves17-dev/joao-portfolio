---
/**
 * A link whose href may still be a placeholder. Placeholders render as plain,
 * non-interactive text so there is never a live link to nowhere.
 */
import { isTodo, type Todo } from "../data/content";

interface Props {
  href: string | Todo | undefined;
  class?: string;
  download?: boolean;
  external?: boolean;
  [key: string]: unknown;
}
const { href, class: cls, download, external, ...rest } = Astro.props;
const missing = href === undefined || isTodo(href);
---
{missing ? (
  <span class={cls} aria-disabled="true" {...rest}><slot /></span>
) : (
  <a
    href={href as string}
    class={cls}
    download={download ? "" : undefined}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    {...rest}
  ><slot /></a>
)}
