---
import { Icon } from "astro-icon/components";
import MaybeLink from "./MaybeLink.astro";
import { isTodo } from "../data/content";
import Tile from "./Tile.astro";
import { education } from "../data/content";
import { useT, pick, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const badge = { studying: "stamp-cobalt", "in-progress": "stamp-ochre", completed: "stamp-solid" } as const;
---
<section id="education" class="section edu" aria-labelledby="edu-title">
  <div class="wrap grid">
    <h2 id="edu-title" class="h2 title">{t("edu.title")}</h2>

    <div class="tl">
      <div class="spine" aria-hidden="true">
        {Array.from({ length: 40 }, (_, i) => <Tile r={i % 2 ? 1 : 2} style={`--paint-o:${(0.84 + ((i * 7) % 5) * 0.04).toFixed(2)}`} />)}
      </div>
      <ol class="timeline">
      {education.map((e) => (
        <li class="entry reveal">
          <span class:list={["node", e.status]} aria-hidden="true"></span>
          <div class="top">
            <h3 class="etitle">{pick(e.title, lang)}</h3>
            <span class:list={["stamp", badge[e.status]]}>{t(`edu.status.${e.status}`)}</span>
          </div>
          <p class="meta">
            <span>{pick(e.kind, lang)}</span>
            <span class="sep" aria-hidden="true">/</span>
            <span>{pick(e.institution, lang)}</span>
          </p>

          {e.courses && e.courses.length > 0 && (
            <div class="courses">
              <h4 class="c-title">{t("edu.courses")}</h4>
              <ul>
                {e.courses.filter((c) => c.status === "completed").map((c) => (
                  <li>
                    <Icon name="ph:check-circle" size={18} aria-hidden="true" />
                    <span>{c.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {e.credential !== undefined && (
            <div class="cred-row">
              <MaybeLink href={e.credential} class="btn btn-primary cred" external>
                <Icon name="ph:certificate" size={20} aria-hidden="true" />
                {t("edu.credential")}
                {!isTodo(e.credential) && <Icon name="ph:arrow-up-right" size={18} aria-hidden="true" class="arrow" />}
              </MaybeLink>
              {isTodo(e.credential) && <span class="cred-note">{pick(e.credential.todo, lang)}</span>}
            </div>
          )}
        </li>
      ))}
    </ol>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 3rem;
  }
  .title {
    grid-column: 1 / span 5;
    align-self: start;
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
    max-width: 11ch;
  }

  /* The spine is an azulejo border: a double cobalt rule, solid for what is
     under way, dashed for what is still ahead. Each entry sits on a diamond tile. */
  /* The spine is a one-tile-wide border column (a barra of the same network tile).
     Each entry is pinned to it by a diamond node. */
  .tl {
    grid-column: 6 / -1;
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1.75rem;
  }
  .spine {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-inline: 2px;
    background: var(--grout);
    overflow: hidden;
    max-height: 100%;
    contain: size;
  }
  .spine :global(.t) { flex: none; width: 100%; }
  .timeline {
    display: grid;
    gap: clamp(2.5rem, 4.5vw, 3.5rem);
    padding-block: 0.5rem 1rem;
  }

  .entry { position: relative; display: grid; gap: 0.55rem; }
  .node {
    position: absolute;
    left: calc(-1.75rem - 2.25rem + 0.325rem);
    top: 0.3rem;
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
  }
  .node::before {
    content: "";
    width: 1.05rem;
    height: 1.05rem;
    transform: rotate(45deg);
    border-radius: 2px;
    background: var(--ground);
    box-shadow: inset 0 0 0 2.5px var(--cobalt), 0 0 0 4px var(--ground);
  }
  .node.studying::before { background: var(--cobalt); box-shadow: inset 0 0 0 3px var(--cobalt), inset 0 0 0 5px var(--ground), 0 0 0 4px var(--ground); }
  .node.completed::before { background: var(--cobalt); box-shadow: 0 0 0 4px var(--ground); }
  .node.in-progress::before { background: var(--ochre); box-shadow: inset 0 0 0 2.5px var(--ink), 0 0 0 4px var(--ground); }

  .top { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .etitle {
    font-size: clamp(1.4rem, 2.3vw, 1.9rem);
    font-weight: 790;
    font-stretch: 110%;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; color: var(--slate); font-size: 1.02rem; }
  .sep { color: var(--rule-strong); }

  .courses {
    margin-top: 0.75rem;
    padding: 1.1rem 1.35rem 1.2rem;
    border-radius: 4px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule);
    max-width: 36rem;
  }
  .c-title { font-size: 0.9rem; font-weight: 720; color: var(--cobalt); }
  .courses ul { display: grid; gap: 0.55rem; margin-top: 0.65rem; }
  .courses li { display: flex; align-items: center; gap: 0.6rem; font-weight: 560; }
  .courses li :global(svg) { color: var(--cobalt); flex: none; }

  .cred-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-top: 0.75rem; }
  .edu :global(.cred[aria-disabled="true"]) {
    background: transparent;
    color: var(--slate);
    box-shadow: inset 0 0 0 1.5px var(--rule-strong);
    border: 0;
    outline: 1.5px dashed color-mix(in srgb, var(--cobalt) 45%, transparent);
    outline-offset: -1.5px;
  }
  .cred-note { font-size: 0.9rem; font-style: italic; color: var(--slate); }

  @media (max-width: 63.99rem) {
    .title { grid-column: 1 / -1; position: static; max-width: none; }
    .tl { grid-column: 1 / -1; }
  }
</style>
