---
import Text from "./Text.astro";
import MaybeLink from "./MaybeLink.astro";
import { education, isTodo } from "../data/content";
import { useT, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section id="education" class="edu" aria-labelledby="edu-title">
  <h2 id="edu-title" class="h2 wide">{t("edu.title")}</h2>
  <ol class="timeline">
    {education.map((e) => (
      <li class="item">
        <p class="years tabular">
          {isTodo(e.start) ? <Text value={e.start} lang={lang} /> : e.start}
          {" - "}
          {e.end === null ? t("edu.present") : isTodo(e.end) ? <Text value={e.end} lang={lang} /> : e.end}
        </p>
        <div>
          <h3 class="etitle"><Text value={e.title} lang={lang} /></h3>
          <p class="place"><Text value={e.place} lang={lang} /></p>
          {e.credential !== undefined && (
            <p class="cred">
              <MaybeLink href={e.credential} external>{t("edu.credential")}</MaybeLink>
              {isTodo(e.credential) && <> <Text value={e.credential} lang={lang} /></>}
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .edu {
    max-width: 90rem;
    margin-inline: auto;
    padding: clamp(4.5rem, 9vw, 7.5rem) clamp(1rem, 3vw, 2.5rem);
  }
  .h2 { font-size: clamp(1.75rem, 3.2vw, 2.75rem); font-weight: 750; letter-spacing: -0.02em; }
  .timeline {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    max-width: 58rem;
  }
  .item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .item:first-child { border-top: 2px solid var(--ink); }
  .years { font-weight: 600; color: var(--ink-soft); }
  .etitle { font-size: 1.15rem; font-weight: 680; line-height: 1.3; }
  .place { color: var(--ink-soft); margin-top: 0.2rem; }
  .cred { margin-top: 0.4rem; font-size: 0.95rem; }
  .cred a { color: var(--link); }

  @media (max-width: 39.99rem) {
    .item { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
