---
import { Icon } from "astro-icon/components";
import MaybeLink from "./MaybeLink.astro";
import { education } from "../data/content";
import { useT, pick, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const badge = { studying: "badge-purple", "in-progress": "badge-gold", completed: "badge-purple" } as const;
---
<section id="education" class="section edu" aria-labelledby="edu-title">
  <div class="wrap grid">
    <h2 id="edu-title" class="h2 title">{t("edu.title")}</h2>

    <ol class="timeline">
      {education.map((e) => (
        <li class="entry">
          <span class:list={["node", e.status]} aria-hidden="true"></span>
          <div class="top">
            <h3 class="etitle">{pick(e.title, lang)}</h3>
            <span class:list={["badge", badge[e.status]]}>{t(`edu.status.${e.status}`)}</span>
          </div>
          <p class="meta">
            <span>{pick(e.kind, lang)}</span>
            <span class="sep" aria-hidden="true">/</span>
            <span>{pick(e.institution, lang)}</span>
          </p>

          {e.courses && e.courses.length > 0 && (
            <div class="courses">
              <h4 class="c-title">{t("edu.courses")}</h4>
              <ul>
                {e.courses.filter((c) => c.status === "completed").map((c) => (
                  <li>
                    <Icon name="lucide:circle-check" size={18} aria-hidden="true" />
                    <span>{c.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {e.credential !== undefined && (
            <MaybeLink href={e.credential} class="cred" external>{t("edu.credential")}</MaybeLink>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .edu { border-top: 1px solid var(--rule); }
  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2rem);
    row-gap: 3rem;
  }
  .title { grid-column: 1 / span 5; align-self: start; max-width: 12ch; }

  .timeline {
    grid-column: 6 / -1;
    position: relative;
    display: grid;
    gap: clamp(2.25rem, 4vw, 3rem);
    padding-left: 2.25rem;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: linear-gradient(var(--purple), var(--purple)) top / 2px calc(100% - 3rem) no-repeat,
      repeating-linear-gradient(var(--rule-strong) 0 6px, transparent 6px 12px);
  }

  .entry { position: relative; display: grid; gap: 0.5rem; }
  .node {
    position: absolute;
    left: -2.25rem;
    top: 0.45rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: inset 0 0 0 3px var(--purple);
  }
  .node.studying { background: var(--purple); box-shadow: 0 0 0 4px var(--purple-tint); }
  .node.in-progress { background: var(--gold); box-shadow: inset 0 0 0 3px var(--ink); }

  .top { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .etitle {
    font-size: clamp(1.4rem, 2.3vw, 1.9rem);
    font-weight: 780;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 0.25rem 0.6rem; color: var(--gray); font-size: 1.02rem; }
  .sep { color: var(--rule-strong); }

  .courses {
    margin-top: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background: var(--white);
    border: 1px solid var(--rule);
    max-width: 34rem;
  }
  .c-title { font-size: 0.9rem; font-weight: 700; color: var(--purple-deep); }
  .courses ul { display: grid; gap: 0.5rem; margin-top: 0.6rem; }
  .courses li { display: flex; align-items: center; gap: 0.6rem; font-weight: 550; }
  .courses li :global(svg) { color: var(--purple); flex: none; }

  .edu :global(.cred) { justify-self: start; margin-top: 0.25rem; font-weight: 600; color: var(--purple-deep); }

  @media (max-width: 63.99rem) {
    .title, .timeline { grid-column: 1 / -1; max-width: none; }
  }
</style>
